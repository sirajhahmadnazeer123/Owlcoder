class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next
class Solution:
    def convert_arr_ll(self,arr):
        head=ListNode(arr[0])
        mover=head
        for i in range(1,len(arr)):
            temp=ListNode(arr[i])
            mover.next=temp
            mover=mover.next
        return head
    def oddEvenList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        e,o=[],[]
        temp=head
        i=0
        if head==None:
            return None
        while(head):
            if i%2==0:
                o.append(temp.val)
                temp=head.next
                i+=1
            else:
                e.append(temp.val)
                temp=head.next
                i+=1
            head=head.next
        arr=o+e
        return self.convert_arr_ll(arr)
